{{- /* Only encrypted (private) sources need GPG; empty disables encryption. */ -}}
{{- $gpgRecipient := promptStringOnce . "gpgRecipient" "GPG recipient fingerprint" -}}
{{- $desktop := promptChoiceOnce . "desktop" "Desktop profile" (list "hyprland" "dwl" "none") -}}
{{- $gpuProfile := promptChoiceOnce . "gpuProfile" "GPU profile" (list "mesa" "nvidia" "intel-x220" "modern-amd-intel") -}}
{{- $machine := promptChoiceOnce . "machine" "Machine profile" (list "generic" "main") -}}
{{- $machineSettings := promptStringOnce . "machineSettings" "Machine settings JSON (empty for portable defaults)" -}}
{{- $dwlOutputs := get . "dwlOutputs" | default "" -}}
{{- if eq $desktop "dwl" -}}
{{- $dwlOutputs = promptStringOnce . "dwlOutputs" "DWL output configuration JSON (empty for machine defaults)" -}}
{{- end -}}
{{- $mail := promptBoolOnce . "features.mail" "Enable mail configuration" -}}
{{- $keepass := promptBoolOnce . "features.keepass" "Enable KeePass configuration" -}}
{{- $wireguard := promptBoolOnce . "features.wireguard" "Enable WireGuard integrations" -}}
{{- $hermes := promptBoolOnce . "features.hermes" "Enable Hermes integrations" -}}
{{ if $gpgRecipient -}}
encryption = "gpg"
{{ end -}}
umask = 0o022

[edit]
hardlink = false
{{- if $gpgRecipient }}

[gpg]
recipient = {{ $gpgRecipient | quote }}
{{- end }}

[data]
gpgRecipient = {{ $gpgRecipient | quote }}
desktop = {{ $desktop | quote }}
gpuProfile = {{ $gpuProfile | quote }}
machine = {{ $machine | quote }}
machineSettings = {{ $machineSettings | quote }}
dwlOutputs = {{ $dwlOutputs | quote }}

[data.features]
mail = {{ $mail }}
keepass = {{ $keepass }}
wireguard = {{ $wireguard }}
hermes = {{ $hermes }}
