font=BlexMono Nerd Font Mono 11
background-color=#${BASE00}
text-color=#${BASE05}
border-color=#${BASE0D}
border-radius=5
border-size=1
width=300
height=750
outer-margin=10
padding=8
max-visible=20
anchor=top-right
default-timeout=15000
markup=1
icons=1
max-icon-size=32
icon-path=${XDG_DATA_HOME}/icons/candy-icons
progress-color=source #${BASE0D}
on-notify=exec pw-play /usr/share/sounds/freedesktop/stereo/bell.oga

[urgency=low]
background-color=#${BASE00}
text-color=#${BASE08}
border-color=#${BASE0D}
default-timeout=7000

[urgency=normal]
background-color=#${BASE00}
text-color=#${BASE07}
border-color=#${BASE0D}
default-timeout=15000

[urgency=critical]
background-color=#${BASE00}
text-color=#${BASE0E}
border-color=#${BASE11}
default-timeout=0

[app-name=Volume]
width=250
anchor=top-right
default-timeout=3000

[app-name=Brightness]
width=250
anchor=top-right
default-timeout=3000

[app-name=Keyboard]
width=150
anchor=top-right
default-timeout=3000
