:root {
  --uc-navbar-margin: -40px;
  --uc-tabs-margin: -50px;
  --uc-hide-delay: 200ms;
  --uc-toolbar-trigger-height: 10px;

  --lwt-accent-color: #${BASE00} !important;
  --lwt-text-color: #${BASE05} !important;
  --toolbox-background-color: #${BASE00} !important;
  --toolbox-background-color-inactive: #${BASE00} !important;
  --toolbox-background-image: none !important;
  --toolbox-text-color: #${BASE05} !important;
  --toolbox-text-color-inactive: #${BASE05} !important;
  --chrome-content-separator-color: #${BASE00} !important;
  --toolbar-bgcolor: #${BASE00} !important;
  --toolbar-color: #${BASE05} !important;
  --toolbar-field-bgcolor: #${BASE01} !important;
  --toolbar-field-color: #${BASE05} !important;
  --toolbar-field-focus-bgcolor: #${BASE01} !important;
  --toolbar-field-focus-color: #${BASE05} !important;
  --tab-selected-bgcolor: #${BASE01} !important;
  --tabs-navbar-background: #${BASE00} !important;
  --arrowpanel-background: #${BASE00} !important;
  --arrowpanel-color: #${BASE05} !important;
  --autocomplete-popup-background: #${BASE00} !important;
  --autocomplete-popup-color: #${BASE05} !important;
  --sidebar-background: #${BASE00} !important;
  --sidebar-text-color: #${BASE05} !important;
  --toolbarbutton-icon-fill: #${BASE05} !important;

  /* Native UI tokens preserve disabled, primary and security states. */
  color-scheme: dark !important;
  accent-color: #${BASE0D};
  --background-color-canvas: #${BASE00} !important;
  --background-color-box: #${BASE01} !important;
  --text-color: #${BASE05} !important;
  --text-color-deemphasized: color-mix(in srgb, #${BASE05} 70%, #${BASE00}) !important;
  --text-color-disabled: color-mix(in srgb, #${BASE05} 45%, #${BASE00}) !important;
  --text-color-error: #${BASE11} !important;
  --color-accent-primary: #${BASE0D} !important;
  --color-accent-primary-hover: #${BASE14} !important;
  --color-accent-primary-active: #${BASE0C} !important;
  --color-accent-primary-selected: #${BASE0D} !important;
  --color-accent-attention: #${BASE0B} !important;
  --focus-outline-color: #${BASE0C} !important;
  --border-color: #${BASE02} !important;
  --border-color-deemphasized: #${BASE03} !important;
  --border-color-interactive: #${BASE02} !important;
  --border-color-interactive-hover: #${BASE0D} !important;
  --border-color-interactive-active: #${BASE0C} !important;
  --border-color-error: #${BASE11} !important;
  --button-background-color: #${BASE01} !important;
  --button-background-color-hover: #${BASE03} !important;
  --button-background-color-active: #${BASE02} !important;
  --button-text-color: #${BASE05} !important;
  --button-border-color: #${BASE02} !important;
  --button-border-color-hover: #${BASE0D} !important;
  --button-border-color-active: #${BASE0C} !important;
  --button-border-color-ghost: transparent !important;
  --button-background-color-ghost-hover: #${BASE02} !important;
  --button-background-color-ghost-active: #${BASE03} !important;
  --button-background-color-menu-hover: #${BASE02} !important;
  --button-background-color-menu-active: #${BASE02} !important;
  --button-background-color-menu-selected: #${BASE02} !important;
  --button-text-color-primary: #${BASE00} !important;
  --button-background-color-primary-disabled: #${BASE04} !important;
  --button-text-color-primary-disabled: #${BASE05} !important;
  --button-background-color-destructive: #${BASE11} !important;
  --button-background-color-destructive-hover: color-mix(in srgb, #${BASE11} 85%, #${BASE05}) !important;
  --button-background-color-destructive-active: color-mix(in srgb, #${BASE11} 90%, #${BASE00}) !important;
  --button-text-color-destructive: #${BASE00} !important;
  --input-text-background-color: #${BASE01} !important;
  --input-text-color: #${BASE05} !important;
  --input-text-border-color: #${BASE02} !important;
  --card-background-color: #${BASE01} !important;
  --card-border-color: #${BASE02} !important;
  --card-border-radius: 8px !important;
  --button-border-radius: 6px !important;
  --link-color: #${BASE0C} !important;
  --link-color-hover: #${BASE16} !important;
  --link-color-active: #${BASE0D} !important;
  --link-color-visited: #${BASE15} !important;
  --background-color-information: color-mix(in srgb, #${BASE0D} 12%, #${BASE00}) !important;
  --background-color-warning: color-mix(in srgb, #${BASE0A} 10%, #${BASE00}) !important;
  --background-color-critical: color-mix(in srgb, #${BASE08} 15%, #${BASE00}) !important;
  --background-color-success: color-mix(in srgb, #${BASE0B} 10%, #${BASE00}) !important;
  --icon-color-information: #${BASE0D} !important;
  --icon-color-warning: #${BASE0A} !important;
  --icon-color-critical: #${BASE11} !important;
  --icon-color-success: #${BASE0B} !important;
  --panel-background-color: #${BASE00} !important;
  --panel-text-color: #${BASE05} !important;
  --panel-border-color: #${BASE0D} !important;
  --panel-separator-color: #${BASE02} !important;
  --toolbar-background-color: #${BASE00} !important;
  --toolbar-text-color: #${BASE05} !important;
  --toolbar-field-background-color: #${BASE01} !important;
  --toolbar-field-background-color-focus: #${BASE01} !important;
  --toolbar-field-text-color: #${BASE05} !important;
  --toolbar-field-text-color-focus: #${BASE05} !important;
  --toolbar-field-border-color: #${BASE02} !important;
  --toolbar-field-border-color-focus: #${BASE0C} !important;
  --toolbarbutton-background-color-hover: #${BASE02} !important;
  --toolbarbutton-background-color-active: #${BASE03} !important;
  --toolbarbutton-outline-color-active: #${BASE0D} !important;
  --toolbarbutton-icon-fill-attention: #${BASE0B} !important;
  --sidebar-background-color: #${BASE00} !important;
}

#titlebar-spacer { display: none !important; }

:root:not([customizing], [inFullscreen]) #navigator-toolbox {
  /* Keep a hover target even when both toolbar rows are collapsed. */
  min-height: var(--uc-toolbar-trigger-height) !important;

  > :is(#nav-bar, #TabsToolbar) {
    opacity: 0 !important;
    pointer-events: none;
    transition: margin-top 0.25s ease var(--uc-hide-delay),
                opacity 0.25s ease var(--uc-hide-delay) !important;
  }

  > #nav-bar {
    margin-top: var(--uc-navbar-margin) !important;
  }

  > #TabsToolbar {
    margin-top: var(--uc-tabs-margin) !important;
  }

  #urlbar {
    transition: opacity 0.25s ease var(--uc-hide-delay) !important;
  }

  &:not(:hover):not(:focus-within):not(:has(
    #toolbar-menubar:not([inactive], [collapsed="true"]),
    #urlbar:is([focused], [open], [popover-open]),
    toolbarbutton[open="true"]
  )) {
    /* Restore native address-field sizing as soon as the toolbox is revealed. */
    :is(#urlbar, #urlbar-container) {
      min-height: 0 !important;
      height: 0 !important;
    }

    #urlbar {
      opacity: 0 !important;
      pointer-events: none !important;
      overflow: hidden !important;
    }
  }

  &:is(:hover, :focus-within, :has(
    #toolbar-menubar:not([inactive], [collapsed="true"]),
    #urlbar:is([focused], [open], [popover-open]),
    toolbarbutton[open="true"]
  )) {
    > :is(#nav-bar, #TabsToolbar) {
      margin-top: 0 !important;
      opacity: 1 !important;
      pointer-events: auto;
      transition-delay: 0s !important;
    }

    #urlbar {
      transition-delay: 0s !important;
    }
  }
}

#TabsToolbar,
#nav-bar,
#PersonalToolbar,
#toolbar-menubar {
  background-color: #${BASE00} !important;
  color: #${BASE05} !important;
}

.tab-background,
.tabbrowser-tab .tab-stack,
.tabbrowser-tab {
  background-color: transparent !important;
}

.tabbrowser-tab:not([selected]):hover .tab-background {
  background-color: #${BASE01} !important;
}

.tabbrowser-tab[selected] .tab-background {
  background-color: #${BASE01} !important;
  box-shadow: inset 0 -2px 0 #${BASE0C} !important;
  border-radius: var(--tab-border-radius) !important;
}

.tabbrowser-tab:not([selected]) .tab-content {
  color: #${BASE15} !important;
}

.tabbrowser-tab[selected] .tab-content {
  color: #${BASE05} !important;
}

.tabbrowser-tab:hover .tab-content {
  color: #${BASE05} !important;
}

#urlbar,
#searchbar {
  --urlbar-background-color: #${BASE01} !important;
  --urlbar-background-color-focus: #${BASE01} !important;
  --urlbar-box-background-color: #${BASE03} !important;
  --urlbar-box-background-color-focus: #${BASE03} !important;
  --urlbar-box-background-color-hover: #${BASE02} !important;
  --urlbar-box-background-color-active: #${BASE04} !important;
}

/* LibreWolf 157 uses classes; retain the older IDs for older profiles. */
#urlbar :is(.urlbar-background, #urlbar-background) {
  background-color: #${BASE01} !important;
}

#urlbar :is(.urlbar-input-container, #urlbar-input-container) {
  color: #${BASE05} !important;
}

#urlbar {
  --lwt-toolbar-field-highlight: #${BASE0D} !important;
  --lwt-toolbar-field-highlight-text: #${BASE00} !important;
}

/* Set the real input's caret explicitly, including during focus transitions. */
#urlbar :is(.urlbar-input, #urlbar-input) {
  caret-color: #${BASE0C} !important;
  cursor: text !important;
}

#urlbar :is(.urlbar-input, #urlbar-input)::selection {
  background-color: #${BASE0D} !important;
  color: #${BASE00} !important;
}

.urlbarView {
  --urlbarview-background-color-hover: #${BASE03} !important;
  --urlbarview-background-color-selected: #${BASE02} !important;
  --urlbarview-text-color-selected: #${BASE05} !important;
  --urlbarview-text-color-action: #${BASE15} !important;
  --urlbarview-text-color-secondary: var(--text-color-deemphasized) !important;
  --urlbarview-separator-color: #${BASE02} !important;
}

/* Native suggestion matches are wrapped in strong elements. */
.urlbarView :is(.urlbarView-title, .urlbarView-url, .urlbarView-tag) > strong {
  color: #${BASE0A} !important;
}

/* Paint the native popup surface, not every child or the transparent host. */
:is(menupopup, panel) {
  --panel-background-color: #${BASE00} !important;
  --panel-text-color: #${BASE05} !important;
  --panel-border-color: #${BASE0D} !important;
  --panel-separator-color: #${BASE02} !important;
  --panel-border-radius: 8px !important;
  --menuitem-border-radius: 4px !important;
}

/* _moz-menuactive also covers keyboard navigation and open submenus. */
menupopup :is(menuitem, menu):not([disabled]):is([_moz-menuactive], :hover) {
  background-color: #${BASE02} !important;
  color: #${BASE05} !important;
}

moz-toggle {
  --toggle-background-color: #${BASE03} !important;
  --toggle-background-color-hover: #${BASE04} !important;
  --toggle-background-color-active: #${BASE02} !important;
  --toggle-background-color-pressed: #${BASE0B} !important;
  --toggle-background-color-pressed-hover: #${BASE12} !important;
  --toggle-background-color-pressed-active: #${BASE0C} !important;
  --toggle-border-color: #${BASE02} !important;
  --toggle-border-color-hover: #${BASE0D} !important;
  --toggle-border-color-active: #${BASE0C} !important;
  --toggle-dot-background-color: #${BASE05} !important;
  --toggle-dot-background-color-hover: #${BASE05} !important;
  --toggle-dot-background-color-active: #${BASE05} !important;
  --toggle-dot-background-color-on-pressed: #${BASE00} !important;
}

#sidebar-box,
#sidebar-main,
#sidebar-header,
#sidebar-search-container {
  background-color: #${BASE00} !important;
  color: #${BASE05} !important;
}

#statuspanel,
#statuspanel-label {
  background-color: #${BASE00} !important;
  color: #${BASE15} !important;
  border-color: #${BASE02} !important;
}

findbar,
.browserContainer > findbar {
  background-color: #${BASE00} !important;
  color: #${BASE05} !important;
  border-color: #${BASE02} !important;
}

#PopupAutoComplete .autocomplete-richlistitem[selected] {
  background-color: #${BASE02} !important;
  color: #${BASE05} !important;
}

#confirmation-hint {
  --panel-background-color: #${BASE01} !important;
  --panel-text-color: #${BASE0B} !important;
  --panel-border-color: #${BASE0B} !important;
}

::selection {
  background: #${BASE02} !important;
  color: #${BASE05} !important;
}

scrollbar {
  -moz-appearance: none !important;
  background-color: #${BASE00} !important;
}

scrollbar thumb {
  background-color: #${BASE02} !important;
  border-radius: 4px !important;
}

scrollbar thumb:hover {
  background-color: #${BASE0C} !important;
}

scrollbar button,
scrollcorner {
  display: none !important;
}
