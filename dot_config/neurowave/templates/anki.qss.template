QMainWindow, QDialog, QWidget {
    background-color: #${BASE00};
    color: #${BASE05};
}

QPushButton {
    background-color: #${BASE02};
    color: #${BASE05};
    border: 1px solid #${BASE02};
    border-radius: 4px;
    padding: 6px 12px;
    min-height: 20px;
}

QPushButton:hover {
    background-color: #${BASE0E};
    border: 1px solid #${BASE15};
}

QPushButton:pressed {
    background-color: #${BASE02};
}

QPushButton:disabled {
    background-color: #${BASE01};
    color: #${BASE10};
}

QToolBar {
    background-color: #${BASE00};
    border: none;
    spacing: 3px;
}

QToolButton {
    background-color: #${BASE02};
    color: #${BASE05};
    border: 1px solid #${BASE02};
    border-radius: 4px;
    padding: 4px;
}

QToolButton:hover {
    background-color: #${BASE0E};
}

QMenuBar {
    background-color: #${BASE00};
    color: #${BASE05};
    border-bottom: 1px solid #${BASE02};
}

QMenuBar::item {
    background-color: transparent;
    padding: 4px 8px;
    border: none;
}

QMenuBar::item:selected {
    background-color: #${BASE0E};
    border: none;
}

QMenuBar::item:pressed {
    background-color: #${BASE02};
    border: none;
}

QMenu {
    background-color: #${BASE01};
    color: #${BASE05};
    border: 1px solid #${BASE02};
}

QMenu::item {
    padding: 6px 24px;
}

QMenu::item:selected {
    background-color: #${BASE02};
}

QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox {
    background-color: #${BASE01};
    color: #${BASE05};
    border: 1px solid #${BASE02};
    border-radius: 3px;
    padding: 4px;
    selection-background-color: #${BASE02};
    selection-color: #${BASE05};
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 1px solid #${BASE0E};
}

QListWidget, QTreeWidget, QTableWidget, QTableView, QAbstractItemView {
    background-color: #${BASE01};
    color: #${BASE05};
    border: 1px solid #${BASE02};
    alternate-background-color: #${BASE01};
    selection-background-color: #${BASE02};
    selection-color: #${BASE05};
}

QListWidget::item:selected,
QTreeWidget::item:selected,
QTableWidget::item:selected,
QTableView::item:selected,
QAbstractItemView::item:selected {
    background-color: #${BASE02};
    color: #${BASE05};
}

QListWidget::item:hover,
QTreeWidget::item:hover,
QTableWidget::item:hover,
QTableView::item:hover,
QAbstractItemView::item:hover {
    background-color: #${BASE0E};
    color: #${BASE05};
}

QListWidget::item:selected:active,
QTreeWidget::item:selected:active,
QTableWidget::item:selected:active,
QTableView::item:selected:active {
    background-color: #${BASE02};
}

QListWidget::item:selected:!active,
QTreeWidget::item:selected:!active,
QTableWidget::item:selected:!active,
QTableView::item:selected:!active {
    background-color: #${BASE02};
}

QScrollBar:vertical {
    background-color: #${BASE01};
    width: 12px;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: #${BASE02};
    border-radius: 6px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background-color: #${BASE0E};
}

QScrollBar:horizontal {
    background-color: #${BASE01};
    height: 12px;
    border: none;
}

QScrollBar::handle:horizontal {
    background-color: #${BASE02};
    border-radius: 6px;
    min-width: 20px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #${BASE0E};
}

QScrollBar::add-line, QScrollBar::sub-line {
    border: none;
    background: none;
}

QTabWidget::pane {
    background-color: #${BASE00};
    border: 1px solid #${BASE02};
}

QTabBar::tab {
    background-color: #${BASE02};
    color: #${BASE05};
    border: 1px solid #${BASE02};
    padding: 6px 12px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background-color: #${BASE0E};
}

QTabBar::tab:hover {
    background-color: #${BASE0E};
}

QComboBox {
    background-color: #${BASE02};
    color: #${BASE05};
    border: 1px solid #${BASE02};
    border-radius: 3px;
    padding: 4px 8px;
}

QComboBox:hover {
    background-color: #${BASE0E};
}

QComboBox::drop-down {
    border: none;
}

QComboBox QAbstractItemView {
    background-color: #${BASE01};
    color: #${BASE05};
    selection-background-color: #${BASE02};
    border: 1px solid #${BASE02};
}

QProgressBar {
    background-color: #${BASE01};
    color: #${BASE05};
    border: 1px solid #${BASE02};
    border-radius: 3px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #${BASE0B};
}

QSplitter::handle {
    background-color: #${BASE02};
}

QStatusBar {
    background-color: #${BASE00};
    color: #${BASE05};
    border-top: 1px solid #${BASE02};
}

QGroupBox {
    color: #${BASE05};
    border: 1px solid #${BASE02};
    border-radius: 4px;
    margin-top: 8px;
    padding-top: 8px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 4px;
    color: #${BASE05};
}

QCheckBox, QRadioButton {
    color: #${BASE05};
    spacing: 6px;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
    background-color: #${BASE01};
    border: 1px solid #${BASE02};
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: #${BASE0B};
}

QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border: 1px solid #${BASE0E};
}

QSlider::groove:horizontal {
    background-color: #${BASE01};
    height: 6px;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background-color: #${BASE02};
    width: 14px;
    margin: -4px 0;
    border-radius: 7px;
}

QSlider::handle:horizontal:hover {
    background-color: #${BASE0E};
}

QToolTip {
    background-color: #${BASE02};
    color: #${BASE05};
    border: 1px solid #${BASE02};
    padding: 4px;
}

QHeaderView::section {
    background-color: #${BASE02};
    color: #${BASE05};
    border: 1px solid #${BASE02};
    padding: 4px;
}

QHeaderView::section:hover {
    background-color: #${BASE0E};
}

QDockWidget {
    color: #${BASE05};
    border: 1px solid #${BASE02};
}

QDockWidget::title {
    background-color: #${BASE02};
    padding: 4px;
}
