{{- /* The X220 lets its idle sound card suspend: holding it open costs it about 0.35 W. */ -}}
{{- if ne .gpuProfile "intel-x220" -}}
monitor.alsa.rules = [
  {
    matches = [
      {
        node.name = "~.*"
      }
    ]
    actions = {
      update-props = {
        session.suspend-timeout-seconds = 0
      }
    }
  }
]
{{ end -}}
