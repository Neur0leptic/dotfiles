{
    "include": ["~/.config/waybar/config.jsonc"],
    "modules-left": ["custom/updates", "dwl/tags", "dwl/window", "tray"],

    "dwl/tags": {
        "num-tags": 10,
        "tag-labels": ["1", "2", "3", "4", "5", "6", "7", "8", "9", "0"],
        "disable-click": false
    },
    "dwl/window": {
        "format": "{title}",
        "max-length": 35
    }
}
