{
    "modules-right": [
{{- if .features.wireguard }}
        "custom/vpn",
{{- end }}
        "custom/custom",
        "custom/quota",
        "custom/system",
        "bluetooth",
        "network",
        "custom/brightness",
        "wireplumber",
        "battery",
        "clock"
    ],
{{- if .features.wireguard }}
    "custom/vpn": {
        "exec": "~/.local/bin/waybar_vpn.sh",
        "return-type": "json",
        "interval": 5,
        "on-click": "~/.local/bin/wireguard.sh"
    },
{{- end }}
    "custom/brightness": {
        "exec": "~/.local/bin/brightness.sh --waybar",
        "return-type": "json",
        "interval": "once",
        "signal": 8,
        "hide-empty-text": true,
        "on-scroll-up": "~/.local/bin/brightness.sh up",
        "on-scroll-down": "~/.local/bin/brightness.sh down"
    }
}
