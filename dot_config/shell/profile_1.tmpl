{{- $validGPUProfiles := list "nvidia" "intel-x220" "modern-amd-intel" -}}
{{- if not (has .gpuProfile $validGPUProfiles) -}}
{{- fail (printf "invalid gpuProfile %q" .gpuProfile) -}}
{{- end -}}
#!/bin/zsh

export PATH="${PATH}:${HOME}/.local/bin:/usr/local/texlive/2023/bin/x86_64-linux"

setopt PROMPT_SP

export BROWSER="librewolf"
export EDITOR="nvim"


export XDG_CONFIG_HOME="${HOME}/.config"
export XDG_DATA_HOME="${HOME}/.local/share"
export XDG_CACHE_HOME="${HOME}/.cache"
export XDG_DOWNLOAD_DIR="${HOME}/downloads"
export XDG_VIDEOS_DIR="${HOME}/videos"
export ZDOTDIR="${XDG_CONFIG_HOME}/zsh"
{{ if eq .gpuProfile "nvidia" -}}
export CUDA_CACHE_PATH="${XDG_CACHE_HOME}/nv"
{{ end -}}
export GNUPGHOME="${XDG_DATA_HOME}/gnupg"
export PASSWORD_STORE_DIR="${XDG_DATA_HOME}/pass"
export FZF_DEFAULT_OPTS="--layout=reverse --height 80%"
export BEMENU_OPTS="-i \
        --nb '#282A36'
        --nf '#F8F8F2' \
        -l '15' \
        --fn 'Monaspace Neon 12' \
        --hf '#50FA7B' \
        --tf '#FF6E6E' \
        --tb '#282A36' \
        --sb '#282A36' \
        --fb '#282A36' \
        --hb '#282A36' \
        --ab '#282A36' \
        --af '#F8F8F2' \
        --bdr '#50FA7B' \
        -s -C -T -n \
        -M '0' -W '0' -B '0' -R '0' --ch 0 --cw 0 \
        --fixed-height"
export BEMENU_BACKEND="wayland"
export QT_SCREEN_SCALE_FACTORS="1;1"
{{ if eq .gpuProfile "nvidia" -}}
export LIBVA_DRIVER_NAME="nvidia"
export __GLX_VENDOR_LIBRARY_NAME="nvidia"
{{ else if eq .gpuProfile "intel-x220" -}}
export LIBVA_DRIVER_NAME="i965"
{{ end -}}
export _JAVA_AWT_WM_NONREPARENTING="1"
export QT_QPA_PLATFORM="wayland"
export QT_QPA_PLATFORMTHEME="qt6ct"
export CLUTTER_BACKEND="wayland"
export SDL_VIDEODRIVER="wayland"
export XDG_SESSION_TYPE="wayland"
export XDG_CURRENT_DESKTOP="hyprland"
export XDG_SESSION_DESKTOP="hyprland"
export MOZ_ENABLE_WAYLAND="1"
export MOZ_DBUS_REMOTE="1"

export XDG_RUNTIME_DIR="/tmp/dwl"
mkdir -p "${XDG_RUNTIME_DIR}"

[ "$(tty)" = "/dev/tty1" ] && ! pidof -s dwl > "/dev/null" 2>&1 && dbus-run-session dwl
