# Shared user environment for login and interactive shells.
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
export XDG_BIN_HOME="${XDG_BIN_HOME:-$HOME/.local/bin}"
export ZDOTDIR="$XDG_CONFIG_HOME/zsh"

for user_bin in "$HOME/.cargo/bin" "$XDG_BIN_HOME"; do
    case ":${PATH:-}:" in
        *":$user_bin:"*) ;;
        *) PATH="$user_bin${PATH:+:$PATH}" ;;
    esac
done
unset user_bin
export PATH
export EDITOR="nvim"
export BROWSER="librewolf"
export PYTHONPYCACHEPREFIX="$XDG_CACHE_HOME/python"
export XDG_DOWNLOAD_DIR="$HOME/downloads"
export XDG_VIDEOS_DIR="$HOME/videos"
export FZF_DEFAULT_OPTS="${FZF_DEFAULT_OPTS:---layout=reverse --height 80%}"
# Keep existing GPG and password-store locations; do not relocate credentials.

{{ if eq .gpuProfile "nvidia" -}}
export CUDA_CACHE_PATH="$XDG_CACHE_HOME/nv"
export GBM_BACKEND="nvidia-drm"
export __GLX_VENDOR_LIBRARY_NAME="nvidia"
export ENABLE_HDR_WSI="1"
export __GL_GSYNC_ALLOWED="1"
export __GL_VRR_ALLOWED="0"
{{ else if not (has .gpuProfile (list "modern-amd-intel" "intel-x220" "mesa")) -}}
{{ fail (printf "invalid GPU profile %q" .gpuProfile) }}
{{ end -}}
{{- $settings := includeTemplate "machine-settings" . | fromJson }}
{{ if ne $settings.vaapi "auto" -}}
export LIBVA_DRIVER_NAME={{ $settings.vaapi | squote }}
{{ end -}}

{{ if has .desktop (list "dwl" "hyprland") -}}
export _JAVA_AWT_WM_NONREPARENTING="1"
export QT_QPA_PLATFORM="wayland"
export QT_QPA_PLATFORMTHEME="qt6ct"
export CLUTTER_BACKEND="wayland"
export SDL_VIDEODRIVER="wayland"
export ELECTRON_OZONE_PLATFORM_HINT="${ELECTRON_OZONE_PLATFORM_HINT:-auto}"
export XDG_SESSION_TYPE="wayland"
export XDG_CURRENT_DESKTOP={{ .desktop | squote }}
export XDG_SESSION_DESKTOP={{ .desktop | squote }}
export MOZ_ENABLE_WAYLAND="1"
export MOZ_DBUS_REMOTE="1"
{{ else if ne .desktop "none" -}}
{{ fail (printf "invalid desktop profile %q" .desktop) }}
{{ end -}}
