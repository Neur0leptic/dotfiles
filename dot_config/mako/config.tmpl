font=BlexMono Nerd Font Mono 11
background-color=#000000
text-color=#e8e8e8
border-color=#99d8fe
border-radius=5
border-size=1
width=300
height=750
outer-margin=10
padding=8
max-visible=20
anchor=top-right
default-timeout=15000
markup=1
icons=1
max-icon-size=32
icon-path={{ env "XDG_DATA_HOME" | default (joinPath .chezmoi.homeDir ".local/share") }}/icons/candy-icons
progress-color=source #99d8fe
on-notify=exec pw-play /usr/share/sounds/freedesktop/stereo/bell.oga

[urgency=low]
background-color=#000000
text-color=#da3030
border-color=#99d8fe
default-timeout=7000

[urgency=normal]
background-color=#000000
text-color=#ffffff
border-color=#99d8fe
default-timeout=15000

[urgency=critical]
background-color=#000000
text-color=#d484fb
border-color=#f95556
default-timeout=0

[app-name=Volume]
width=250
anchor=top-right
default-timeout=3000

[app-name=Brightness]
width=250
anchor=top-right
default-timeout=3000

[app-name=Keyboard]
width=150
anchor=top-right
default-timeout=3000
