+			XKB_STATE_LAYOUT_EFFECTIVE);
+	name = xkb_keymap_layout_get_name(keyboard->keymap, layout);
+	runtime_dir = getenv("XDG_RUNTIME_DIR");
+	path_len = runtime_dir
+			? snprintf(path, sizeof(path), "%s/dwl-keymap", runtime_dir) : -1;
+	if (path_len > 0 && (size_t)path_len < sizeof(path)
+			&& (file = fopen(path, "w"))) {
+		fprintf(file, "%s\n", name ? name : "unknown");
+		fclose(file);
+	}
+	if (previous != XKB_LAYOUT_INVALID && previous != layout)
+		spawn(&(Arg){.v = kb_notify_cmd});
+	previous = layout;
+}
