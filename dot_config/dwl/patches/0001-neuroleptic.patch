+uint32_t
+initialoutputtag(const char *name)
+{
+	Monitor *m;
+	wl_list_for_each(m, &mons, link)
+		if (!strcmp(m->wlr_output->name, name) && m->configured_tags)
+			return m->configured_tags & -m->configured_tags;
+	return 1u;
+}
+
+int
+outputmatches(const char *name, const char *expected, int connected)
+{
+	DIR *directory;
+	struct dirent *entry;
+	char path[512], hash[128], suffix[256];
+	int found = 0;
+	size_t length, suffix_length;
+	if (!connected && (!expected || !expected[0]))
+		return 1;
+	if (!name || (expected && expected[0] && strlen(expected) != 64)
+			|| snprintf(suffix, sizeof(suffix), "-%s", name) >= (int)sizeof(suffix)
+			|| !(directory = opendir("/sys/class/drm")))
+		return 0;
+	suffix_length = strlen(suffix);
+	while (!found && (entry = readdir(directory))) {
+		FILE *stream;
+		int fds[2], status = 0;
+		pid_t child, waited;
+		sigset_t blocked, previous;
+		length = strlen(entry->d_name);
+		if (strncmp(entry->d_name, "card", 4) || length <= suffix_length
+				|| strcmp(entry->d_name + length - suffix_length, suffix))
+			continue;
+		if (connected) {
+			snprintf(path, sizeof(path), "/sys/class/drm/%s/status", entry->d_name);
+			if (!(stream = fopen(path, "r")))
+				continue;
+			found = fgets(hash, sizeof(hash), stream) && !strcmp(hash, "connected\n");
+			fclose(stream);
+			if (!found)
+				continue;
+			if (!expected || !expected[0])
+				break;
+			found = 0;
+		}
+		snprintf(path, sizeof(path), "/sys/class/drm/%s/edid", entry->d_name);
+		if (pipe(fds))
+			continue;
+		sigemptyset(&blocked);
+		sigaddset(&blocked, SIGCHLD);
+		sigprocmask(SIG_BLOCK, &blocked, &previous);
+		child = fork();
+		if (child == 0) {
+			close(fds[0]);
+			if (dup2(fds[1], STDOUT_FILENO) == -1)
+				_exit(127);
+			close(fds[1]);
+			sigprocmask(SIG_SETMASK, &previous, NULL);
+			execlp("sha256sum", "sha256sum", "--", path, (char *)NULL);
+			_exit(127);
+		}
+		close(fds[1]);
+		hash[0] = '\0';
+		if (child > 0 && (stream = fdopen(fds[0], "r"))) {
+			if (!fgets(hash, sizeof(hash), stream))
+				hash[0] = '\0';
+			fclose(stream);
+		} else {
+			close(fds[0]);
+		}
+		if (child > 0) {
+			do waited = waitpid(child, &status, 0); while (waited < 0 && errno == EINTR);
+			found = waited == child && WIFEXITED(status) && WEXITSTATUS(status) == 0
+					&& strlen(hash) >= 65 && hash[64] == ' '
+					&& !strncmp(hash, expected, 64);
+		}
+		sigprocmask(SIG_SETMASK, &previous, NULL);
+	}
+	closedir(directory);
+	return found;
+}
+
+Monitor *
+monitorfortag(uint32_t tags, int fallback)
+{
+	Monitor *m, *first = NULL;
+	uint32_t first_tag = tags & -tags;
+	wl_list_for_each(m, &mons, link) {
+		if (!m->wlr_output->enabled)
+			continue;
+		if (!first)
+			first = m;
+		if (first_tag & m->configured_tags)
+			return m;
+	}
+	if (!fallback)
+		return NULL;
+	if (selmon && selmon->wlr_output->enabled)
+		return selmon;
+	return first;
+}
+
+void
+rehomeclients(void)
+{
+	Client *c;
+	Monitor *m, *target;
+	uint32_t active = selmon ? selmon->tagset[selmon->seltags] : 0;
+
+	wl_list_for_each(c, &clients, link) {
+		target = monitorfortag(c->tags, 0);
+		if (target && target != c->mon)
+			setmon(c, target, c->tags);
+	}
+	wl_list_for_each(m, &mons, link) {
+		uint32_t tags = m->tagset[m->seltags];
+		target = monitorfortag(tags, 0);
+		if (target && target != m) {
+			m->seltags ^= 1;
+			m->tagset[m->seltags] = initialoutputtag(m->wlr_output->name);
+			arrange(m);
+		}
+	}
+	if ((target = monitorfortag(active, 0)))
+		selmon = target;
+}
