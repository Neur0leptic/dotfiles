+void
+configureoutputstate(struct wlr_output_state *state, struct wlr_output *output,
+		const MonitorRule *rule)
+{
+	struct wlr_output_mode *mode, *selected = NULL;
+
+	wlr_output_state_init(state);
+	wlr_output_state_set_enabled(state, !rule->disabled);
+	wlr_output_state_set_scale(state, rule->scale);
+	wlr_output_state_set_transform(state, rule->rr);
+
+	if (rule->width > 0 && rule->height > 0) {
+		wl_list_for_each(mode, &output->modes, link) {
+			if (mode->width == rule->width && mode->height == rule->height
+					&& (!rule->refresh || abs(mode->refresh - rule->refresh) <= 100)) {
+				selected = mode;
+				break;
+			}
+		}
+	}
+	if (!selected)
+		selected = wlr_output_preferred_mode(output);
+	if (selected)
+		wlr_output_state_set_mode(state, selected);
+}
