+void
+setupcolormanagement(void)
+{
+	enum wp_color_manager_v1_render_intent render_intents[] = {
+		WP_COLOR_MANAGER_V1_RENDER_INTENT_PERCEPTUAL,
+	};
+	enum wp_color_manager_v1_primaries *primaries;
+	enum wp_color_manager_v1_transfer_function *transfer_functions;
+	struct wlr_color_manager_v1_options options = {0};
+
+	if (!drw->features.input_color_transform) {
+		wlr_log(WLR_INFO, "renderer has no color-transform support; color management disabled");
+		return;
+	}
+
+	options.features = (struct wlr_color_manager_v1_features){
+		.parametric = true,
+		.set_mastering_display_primaries = true,
+	};
+	options.render_intents = render_intents;
+	options.render_intents_len = LENGTH(render_intents);
+	primaries = wlr_color_manager_v1_primaries_list_from_renderer(drw,
+			&options.primaries_len);
+	options.primaries = primaries;
+	transfer_functions = wlr_color_manager_v1_transfer_function_list_from_renderer(
+			drw, &options.transfer_functions_len);
+	options.transfer_functions = transfer_functions;
+
+	color_mgr = wlr_color_manager_v1_create(dpy, 2, &options);
+	if (color_mgr) {
+		wlr_scene_set_color_manager_v1(scene, color_mgr);
+		wlr_color_representation_manager_v1_create_with_renderer(dpy, 1, drw);
+	}
+	free(transfer_functions);
+	free(primaries);
+}
