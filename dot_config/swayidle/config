timeout 600 'pidof kitty || kitty --class fullscreen -e unimatrix -c cyan &'
timeout 1000 'swaylock' resume 'pkill -f "kitty.*unimatrix"'
timeout 1200 'hyprctl dispatch "hl.dsp.dpms({ action = \"off\" })" 2>/dev/null' resume 'hyprctl dispatch "hl.dsp.dpms({ action = \"on\" })" 2>/dev/null'
timeout 1800 'pkill kitty 2>/dev/null; systemctl suspend || doas sh -c "echo mem > /sys/power/state"'

before-sleep 'pkill -USR1 swaylock; sleep 0.3; pkill -9 swaylock'
after-resume 'hyprctl dispatch "hl.dsp.dpms({ action = \"on\" })" && swaylock -f'
