#!/bin/sh

pids=""

start() {
    command -v "$1" >/dev/null 2>&1 || return 0
    "$@" &
    pids="$pids $!"
}

cleanup() {
    trap - 0 1 2 15
    for pid in $pids; do
        kill "$pid" 2>/dev/null || true
    done
    wait 2>/dev/null || true
}
trap cleanup 0 1 2 15

session_env="$HOME/.local/bin/wayland-session-env"
[ -x "$session_env" ] || {
    printf 'missing session environment helper: %s\n' "$session_env" >&2
    exit 1
}
"$session_env"

# Output, input and tag preferences are already compiled from the user's config.h.

# Gentoo's launcher runs PipeWire and WirePlumber inside this session's D-Bus;
# 'restart' clears an earlier session's leftovers. systemd hosts lack it.
start gentoo-pipewire-launcher restart
start foot --server
start mako
start wlsunset -S 06:30 -s 18:30 -d 1800
start clipse -listen
# logind tells swayidle about every suspend: lock before it, and after it turn the screens
# on and replace a lock that died. swayidle without logind support refuses these hooks.
if [ -d /run/systemd/system ]; then
    start swayidle -w -C "$HOME/.config/swayidle/config-dwl" \
        before-sleep 'pgrep -x swaylock >/dev/null || swaylock -f' \
        after-resume 'wlopm --on "*"; pgrep -x swaylock >/dev/null || swaylock -f'
else
    start swayidle -w -C "$HOME/.config/swayidle/config-dwl"
fi
start wayland-pipewire-idle-inhibit --wayland --quiet

# Waybar is started on demand by waybar_toggle.sh (Super+B).

wait
