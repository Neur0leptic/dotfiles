#!/bin/sh
# Apply explicit connector preferences. wlroots handles unconfigured outputs.
set -eu

config="${XDG_CONFIG_HOME:-$HOME/.config}/dwl/outputs.json"
[ -f "$config" ] || exit 0
current=$(wlr-randr --json)
connected=$(printf '%s\n' "$current" | jq -r '.[].name')
settings=$(jq -er '.outputs | map([.name, (.mode // "preferred"),
    (.scale // 1), (if .enabled == false then "off" else "on" end),
    (.position // "auto"), (.edid // "-")] | @tsv) | join("\n")' "$config")
set --
enabled=0
while IFS="$(printf '\t')" read -r name mode scale state position expected_edid; do
    [ -n "$name" ] || continue
    printf '%s\n' "$connected" | grep -qxF -- "$name" || continue
    if [ -n "$expected_edid" ] && [ "$expected_edid" != '-' ]; then
        matched=0
        for edid in /sys/class/drm/card*-"$name"/edid; do
            [ -r "$edid" ] || continue
            actual=$(sha256sum "$edid")
            [ "${actual%% *}" != "$expected_edid" ] || matched=1
        done
        [ "$matched" -eq 1 ] || continue
    fi
    set -- "$@" --output "$name" "--$state"
    [ "$state" = on ] || continue
    enabled=$((enabled + 1))
    if [ "$mode" = preferred ]; then
        set -- "$@" --preferred
    else
        set -- "$@" --mode "$mode"
    fi
    set -- "$@" --scale "$scale"
    [ "$position" = auto ] || set -- "$@" --pos "$position"
done <<EOF
$settings
EOF
# A disconnected selected screen must not leave the session without a display.
[ "$enabled" -gt 0 ] || exit 0
wlr-randr --dryrun "$@"
exec wlr-randr "$@"
