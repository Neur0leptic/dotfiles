[%General]
author=Neurowave
comment=Cyberdeck Neurowave theme
x11drag=true
alt_mnemonic=true
left_tabs=false
attach_active_tab=false
mirror_doc_tabs=false
embedded_tabs=true
group_toolbar_buttons=false
toolbar_interior_spacing=1
composite=true
menu_shadow_depth=4
menu_blur_radius=2
spread_menuitems=true
tooltip_shadow_depth=4
tooltip_blur_radius=2
splitter_width=6
scroll_width=10
scroll_min_extent=40
slider_width=6
slider_handle_width=14
slider_handle_length=14
blurring=true
button_icon_size=16
click_behavior=0
fill_rubberband=false
large_icon_size=32
progressbar_thickness=8
menubar_mouse_tracking=true
merge_menubar_with_toolbar=true
popup_blurring=true
scroll_arrows=false
small_icon_size=16
toolbar_icon_size=16
toolbutton_style=0
translucent_windows=false
vertical_spin_indicators=false
inline_spin_indicators=true
combo_as_lineedit=true
combo_menu=true
combo_focus_rect=true
animate_states=true
tree_branch_line=true
transient_scrollbar=true
groupbox_top_label=true
reduce_window_opacity=4
remove_extra_frames=true
roundness=6

[GeneralColors]
window.color=#000000
base.color=#0d0d14
alt.base.color=#0d0d14
button.color=#0d0d14
light.color=#1c272a
mid.light.color=#293542
dark.color=#000000
mid.color=#0d0d14
highlight.color=#463465
inactive.highlight.color=#1c272a
tooltip.base.color=#0d0d14
text.color=#e8e8e8
window.text.color=#e8e8e8
button.text.color=#e8e8e8
disabled.text.color=#1c272a
tooltip.text.color=#e8e8e8
highlight.text.color=#e8e8e8
link.color=#99d8fe
link.visited.color=#99d8fe

[Hacks]
respect_darkness=true
blur_translucent=false
force_size_grip=true
iconless_menu=false
iconless_pushbutton=false
transparent_dolphin_view=true
transparent_pcmanfm_view=true
transparent_pcmanfm_sidepane=true

[General]
theme=Neurowave

[Window]
background.color=#000000
foreground.color=#e8e8e8
background.alternate.color=#0d0d14

[Selection]
background.color=#463465
foreground.color=#e8e8e8

