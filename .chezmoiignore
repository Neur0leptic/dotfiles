README.md
docs/**

# Repository metadata is never installed into $HOME.
.gitignore
dwl-machines
dwl-machines/**

# lazy.nvim rewrites its plugin lock whenever it updates plugins, so each machine keeps
# its own; a shared copy made the machines' syncs conflict.
.config/nvim/lazy-lock.json

# DWL: ~/.local/src/dwl/config.h is the only editable header. Sync keeps its shared
# part in config.def.h (a source input only) and its machine sections in dwl-machines/.
# Installer apply preserves the header; normal sync captures it and apply restores it.
.config/dwl/config.def.h
{{- $dwlProfile := includeTemplate "dwl-config-profile" . }}
{{- $dwlSaved := joinPath .chezmoi.sourceDir "dwl-machines" (printf "%s.h" $dwlProfile) }}
{{- if or (eq (env "CHEZMOI_PRESERVE_DWL_CONFIG") "1") (and (ne .desktop "dwl") (not (stat (joinPath .chezmoi.destDir ".local/src/dwl/config.h"))) (not (stat $dwlSaved))) }}
.local/src/dwl/config.h
{{- end }}
.config/dwl/outputs.json

{{- if ne .chezmoi.os "linux" }}
.local/src/dwl/**
.config/**
.local/bin/**
.librewolf/**
.local/share/themes/Neurowave/**
.local/share/Kvantum/Neurowave/**
{{- end }}

# Desktop-specific sources remain in Git but are only applied when selected.
{{- if eq .desktop "hyprland" }}
.config/dwl/**
.config/swayidle/config-dwl
.config/waybar/config-dwl.jsonc
.config/waybar/style-dwl.css
{{- else if eq .desktop "dwl" }}
.config/hypr/**
.config/swayidle/config
{{- else }}
.config/dwl/**
.config/hypr/**
.config/swayidle/**
.config/waybar/**
.config/mako/**
.config/nvim/lua/plugins/colorscheme.lua
.config/foot/**
.config/librewolf/**
.config/helium-browser-theme.json
.config/browser-extensions.json
.librewolf/**
.local/share/themes/Neurowave/**
.local/share/Kvantum/Neurowave/**
.local/bin/setup_librewolf.sh
.local/bin/setup_browser_theme.sh
{{- end }}

# Historical presets are replaced by the concrete machine-settings data.
.config/hypr/machines/**

# GPU variants are synchronized through Git but only one is active locally.
{{- if ne .gpuProfile "nvidia" }}
.config/mpv/gpus/nvidia.conf
{{- end }}
{{- if ne .gpuProfile "intel-x220" }}
.config/mpv/gpus/intel-x220.conf
{{- end }}
{{- if ne .gpuProfile "modern-amd-intel" }}
.config/mpv/gpus/modern-amd-intel.conf
{{- end }}
{{- if ne .gpuProfile "mesa" }}
.config/mpv/gpus/mesa.conf
{{- end }}

{{- if not .features.mail }}
.config/aerc/**
.config/systemd/user/email-check.service
.config/systemd/user/email-check.timer
.local/bin/email_notifier.sh
{{- end }}

{{- if not .features.keepass }}
.config/keepass/**
.config/keepassxc/**
.local/bin/kp.py
.local/bin/kprofi.sh
{{- end }}

{{- if not .features.wireguard }}
.config/wireguard/**
.local/bin/wireguard.sh
.local/bin/waybar_vpn.sh
{{- end }}

{{- $settings := includeTemplate "machine-settings" . | fromJson }}
{{- if not $settings.wireguardProfile }}
.config/wireguard/device.json
.config/wireguard/default-relay
{{- end }}

{{- if not .features.hermes }}
.config/systemd/user/acp-relay.service
.config/systemd/user/hermes-gateway.service
.local/bin/hermes-launch.sh
{{- end }}
